# Publish only application sources, runtime assets and required build files.
/*
!/.gitignore
!/app/
!/background_picture/
!/gradle/
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat

/app/*
!/app/build.gradle.kts
!/app/proguard-rules.pro
!/app/src/
/app/src/*
!/app/src/main/

/gradle/*
!/gradle/libs.versions.toml
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties

# Markdown stays local, including files under otherwise allowed directories.
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]

